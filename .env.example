# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Local SQLite for immediate zero-config testing:
DATABASE_URL="file:./dev.db"
# For PostgreSQL in production:
# DATABASE_URL="postgresql://user:password@localhost:5432/travel_booking_db?schema=public"

# ==========================================
# HOTEL INTEGRATION (Booking.com Demand API)
# ==========================================
HOTEL_PROVIDER=mock # Options: 'mock' | 'booking_com'
BOOKING_COM_BASE_URL=https://demandapi.booking.com/3.2
BOOKING_COM_API_KEY=
BOOKING_COM_AFFILIATE_ID=

# ==========================================
# FLIGHT INTEGRATION (Amadeus Flight API)
# ==========================================
FLIGHT_PROVIDER=mock # Options: 'mock' | 'amadeus'
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com/v2

# ==========================================
# CAB / TRANSFER INTEGRATION
# ==========================================
CAB_PROVIDER=mock # Options: 'mock' | 'uber'
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=

# ==========================================
# AI / LLM CONFIGURATION (Google Gemini / Fallback rule engine)
# ==========================================
LLM_PROVIDER=gemini # Options: 'gemini' | 'rule_engine'
GEMINI_API_KEY=
