generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Change to "postgresql" for PostgreSQL in production
  url      = env("DATABASE_URL")
}

model Session {
  id               String    @id @default(uuid())
  currentStep      String    @default("INITIATION") // INITIATION, FLIGHT_SELECTION, HOTEL_SELECTION, CAB_SELECTION, CHECKOUT_SUMMARY, CONFIRMED
  destination      String?
  origin           String?
  startDate        String?
  endDate          String?
  guests           Int       @default(1)
  budget           Float?
  selectedFlightId String?
  selectedHotelId  String?
  selectedCabId    String?
  orderToken       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  messages         Message[]
  bookings         Booking[]
}

model Message {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant" | "system"
  content   String
  metadata  String? // JSON string containing rich card items (flights, hotels, cabs, summary, ticket)
  createdAt DateTime @default(now())
}

model Booking {
  id               String   @id @default(uuid())
  sessionId        String
  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  bookingReference String   @unique
  passengerName    String   @default("Valued Traveler")
  passengerEmail   String   @default("traveler@example.com")
  flightDetails    String? // JSON string
  hotelDetails     String? // JSON string
  cabDetails       String? // JSON string
  totalCost        Float
  currency         String   @default("USD")
  status           String   @default("CONFIRMED")
  pdfPath          String?
  createdAt        DateTime @default(now())
}
